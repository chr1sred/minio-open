# Copie para deploy/.env e troque TODAS as senhas.
# Gere senhas fortes com:  openssl rand -hex 24

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=troque-esta-senha-admin

# URLs publicas (deixe vazio em teste local)
MINIO_SERVER_URL=https://s3.seudominio.com
MINIO_BROWSER_REDIRECT_URL=https://minio.seudominio.com

# Memoria maxima do MinIO (VPS 4 GB -> 1GiB)
MINIO_MEMLIMIT=1GiB

# Configuracao automatica para o Typebot
MINIO_INIT_BUCKETS=typebot
MINIO_INIT_PUBLIC_PATHS=typebot/public
MINIO_INIT_APP_USER=typebot
MINIO_INIT_APP_PASSWORD=troque-esta-senha-do-typebot
