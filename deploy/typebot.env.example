# Variaveis S3 para o Typebot (adicione no builder E no viewer).
# Nomes conferidos em packages/env/src/index.ts do Typebot (branch main).

S3_ACCESS_KEY=typebot
S3_SECRET_KEY=<MINIO_INIT_APP_PASSWORD>
S3_BUCKET=typebot
# Somente o host, sem https:// e sem barra no final
S3_ENDPOINT=s3.seudominio.com
S3_SSL=true
S3_REGION=us-east-1
# S3_PORT so e necessario se NAO usar 443/80
# S3_PORT=9000
# Opcional: dominio/CDN na frente do bucket para os arquivos publicos
# S3_PUBLIC_CUSTOM_DOMAIN=https://arquivos.seudominio.com
